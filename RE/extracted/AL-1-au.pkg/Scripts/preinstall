#!/bin/sh
set -eu

target_volume="${3:-/}"
target_volume="${target_volume%/}"

au_relative_path="/Library/Audio/Plug-Ins/Components/AL-1.component"
global_au_path="${target_volume}${au_relative_path}"

echo "AL-1 AU preinstall: removing existing bundle at ${global_au_path}"
rm -rf "${global_au_path}"

# Cleanup legacy per-user AU installs so the system copy is used after upgrade.
users_root="${target_volume}/Users"
if [ -d "${users_root}" ]; then
  find "${users_root}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | while IFS= read -r user_home; do
    legacy_au_path="${user_home}/Library/Audio/Plug-Ins/Components/AL-1.component"
    if [ -e "${legacy_au_path}" ]; then
      echo "AL-1 AU preinstall: removing legacy bundle at ${legacy_au_path}"
      rm -rf "${legacy_au_path}"
    fi
  done
fi

exit 0
